# Copy to .env.local for `npm start`. Nothing here is a secret: a
# create-react-app bundle is public, so never put a credential in a
# REACT_APP_* variable.

# Where the Rails API lives. Defaults to http://localhost:3001/api/v1.
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# How long to wait for the API before giving up, in milliseconds. Default 10000.
REACT_APP_API_TIMEOUT_MS=10000

# Dev-server port for `npm start`. Create React App reads this directly.
PORT=3000
