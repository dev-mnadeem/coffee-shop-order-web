# Copy to .env.local for `npm start`. Nothing here is a secret: the Vite
# bundle is public, so never put a credential in a VITE_* variable.

# Where the Rails API lives. Defaults to http://localhost:3001/api/v1.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# How long to wait for the API before giving up, in milliseconds. Default 10000.
VITE_API_TIMEOUT_MS=10000
