{
  "name": "agnos-coffee-shop-fe",
  "version": "0.1.0",
  "private": true,
  "description": "React storefront and till for the Agnos coffee shop API.",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
