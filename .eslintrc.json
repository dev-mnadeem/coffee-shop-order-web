{
  "root": true,
  "extends": ["react-app", "react-app/jest", "prettier"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-alert": "error",
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "**/*.test.jsx", "src/test/**/*.js"],
      "rules": { "no-console": "off" }
    }
  ]
}
